PORT=8080
NODE_ENV=development
APP_URL=http://localhost:8080
# Produção: HTTPS da Vercel, paths absolutos no volume persistente e NODE_ENV=production.
DB_PATH=
UPLOAD_DIR=
BACKUP_DIR=
TRUST_PROXY=loopback
# Sem barra final, separados por vírgula; não uses wildcards ou todos os previews da Vercel.
ALLOWED_ORIGINS=
REQUIRE_EMAIL_VERIFICATION=false
# Produção: lista explícita de e-mails convidados. Não a publiques com dados reais.
BETA_EMAILS=
MAIL_FROM="Lume <fotografia@teu-dominio.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Apenas na Vercel: HTTPS da API Express persistente (ex.: https://api.teu-dominio.com).
BACKEND_ORIGIN=
