{
  "name": "lume",
  "version": "2.0.0",
  "private": true,
  "description": "LUME, O Brilho de Moçambique — plataforma colaborativa de fotografia artística de Moçambique",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node scripts/seed.js",
    "admin": "node --env-file-if-exists=.env scripts/make-admin.js",
    "map": "python3 scripts/build-map.py",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "import:photos": "node --env-file-if-exists=.env scripts/import-michael-photos.js",
    "seed:community": "node --env-file-if-exists=.env scripts/seed-community.js",
    "build:vercel": "node scripts/build-vercel.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "catalog:export": "node scripts/export-catalog.js",
    "catalog:import": "node --env-file-if-exists=.env scripts/import-catalog.js",
    "profile:assign": "node --env-file-if-exists=.env scripts/assign-profile-email.js",
    "check:production": "node --env-file-if-exists=.env scripts/check-production.js",
    "build:supabase": "node scripts/build-supabase.js",
    "supabase:schema": "node scripts/supabase-schema.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "image-size": "^2.0.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.8"
  }
}
